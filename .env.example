# Example environment variables for running the OTP builder/server via docker-compose.
# Copy this file to `.env` and adjust values for your environment before running Docker Compose.
#
# Notes:
# - OTP_JAR: path to the otp.jar inside the container image. Common locations:
#     /usr/local/otp/otp.jar
#     /opt/otp/otp.jar
#   If your chosen OTP image exposes a different layout or wrapper script, adjust accordingly.
# - JAVA_OPTS: JVM heap/settings for build and server. Increase (-Xmx) for larger networks.
# - BUILD_OPTS: extra options passed to the OTP jar during build (e.g. "--embedRouterConfig router-config.json").
# - OTP_BASE_URL / OTP_ROUTER_ID: used by the Nuxt app v2 adapter to locate the OTP instance.
# - NOMINATIM_*: geocoding options used by the v2 API proxy (optional).
#
# Important security tip:
# - Do NOT commit a real .env with secrets/APIs to source control. Use this example as a template.

########################
# OTP builder / server
########################

# Path (inside the container) to the OTP jar. If left blank, the builder will try common locations.
OTP_JAR=/usr/local/otp/otp.jar

# JVM options for OTP processes. Increase -Xmx for larger builds (e.g. -Xmx8G or -Xmx12G).
# Keep this consistent across builder and server to ensure sufficient memory.
JAVA_OPTS=-Xmx6G

# Extra build options passed to the OTP jar at build time (optional).
# Example: --embedRouterConfig router-config.json
BUILD_OPTS=

########################
# Data directories (host paths)
# These are illustrative — docker-compose mounts ./data/... into the container.
# Ensure you put your PBF and GTFS files under the host ./data directories.
########################

# Example PBF & GTFS file names expected under ./data/osm and ./data/gtfs respectively.
# (You do not need to set these here unless you customize the builder script to use them.)
PBF_FILENAME=west-bengal-latest.osm.pbf
GTFS_DIR=./data/gtfs

########################
# OTP runtime (for the Nuxt v2 adapter)
########################

# Base URL where OTP is reachable from the Nuxt server (used by /api/v2/directions).
# If OTP runs on the same host and docker exposes :8080 to the host, use:
OTP_BASE_URL=http://host.docker.internal:8080/otp
# OTP_BASE_URL=http://localhost:8080/otp    # alternative for some setups

# Router ID used in OTP graphs (default "default").
OTP_ROUTER_ID=default

########################
# Nominatim (geocoding) options for the v2 adapter (optional)
########################

# Whether to enable geocoding of freeform addresses via Nominatim from the v2 endpoint.
# If using the public nominatim.openstreetmap.org service, be mindful of its usage policy.
NOMINATIM_ENABLED=true

# Override the nominatim base URL (default public instance).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

########################
# Misc / optional
########################

# Number of itineraries to request by default (v2 API will override if client sends value).
DEFAULT_NUM_ITINERARIES=3

# Example: set to "true" to enable verbose logs from OTP process (if supported by your image).
OTP_DEBUG=false

########################
# How to use
########################
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Edit .env and set OTP_JAR/JAVA_OPTS and other values as appropriate.
# 3. Ensure files are placed:
#      ./data/osm/<your-pbf>.pbf
#      ./data/gtfs/<your-gtfs>.zip
# 4. Build the OTP graph (one-off):
#      docker compose run --rm otp-builder
# 5. Start the OTP server:
#      docker compose up -d otp
#
# If you need help finding GTFS feeds for Kolkata or trimming PBF extracts, follow the repo docs or ask for guidance.
